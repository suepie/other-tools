# このファイルを terraform.tfvars にコピーして編集します。
#   cp terraform.tfvars.example terraform.tfvars
#
# ★ terraform.tfvars は .gitignore 済みです。
#   パスワード・トークン・AWS のアクセスキーをここに書く必要は一切ありません。

project = "project-a"
region  = "ap-northeast-1"

# ★複数アカウントを扱うなら必ず指定してください。
#   ここに書いたアカウント以外の認証情報で実行すると、リソースを触る前に停止します。
#   AWS_PROFILE の切り替え忘れが事故になりません。
aws_profile         = "forge-project-a"   # プロファイル名。空なら環境変数 AWS_PROFILE を見ます
allowed_account_ids = ["111111111111"]

# 接続を許可する固定 IP。CloudFront 手前の WAF で制限します。
allowed_cidrs = [
  "203.0.113.10/32",  # 本社
  "198.51.100.20/32", # データセンタ
]

# URL は CloudFront の既定ドメイン（https://xxxxx.cloudfront.net/）になります。
# 独自ドメインも DNS 設定も不要です。apply 後 `terraform output forge_url` で確認できます。

# 初期管理者。パスワードは Terraform が生成して Secrets Manager に入れます。
admin_username = "forgeadmin"
admin_email    = "admin@example.com"

# ---- 任意 ----------------------------------------------------------------

# CloudFront がオリジンの応答を待つ秒数（1〜120）。既定 120。
# 「無通信が続いた時間」の上限で、合計時間ではありません。
# 大きな push でサーバ側処理が長い場合に効きます。
# origin_read_timeout = 120

# 日本国内利用なら PriceClass_200 で足ります
# cloudfront_price_class = "PriceClass_200"

# Managed Instances が選ぶインスタンスの下限。CI が重いなら上げてください。
# instance_vcpu_min       = 2
# instance_memory_mib_min = 4096
# instance_storage_gib    = 100

# CI で x86 バイナリをビルドするなら Graviton を除外する
# cpu_manufacturers = ["intel", "amd"]

# イメージタグは公式で最新を確認して固定してください
# forge_image  = "codeberg.org/forgejo/forgejo:11"
# runner_image = "code.forgejo.org/forgejo/runner:9"

# ランナーのラベル（ワークフローの runs-on に書く値）
# runner_labels = "docker:docker://node:22-bookworm"

# Actions を使わない場合
# enable_runner = false

# RDS
# db_instance_class    = "db.t4g.micro"
# db_allocated_storage = 20

# 本番では 7〜30 を推奨（0 は destroy 後すぐ作り直せる検証向け）
# secret_recovery_window_days = 7
