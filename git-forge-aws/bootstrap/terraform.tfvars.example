# このファイルを terraform.tfvars にコピーして編集します。
#   cp terraform.tfvars.example terraform.tfvars
#
# bootstrap は tfstate の置き場（S3 + KMS）を作るだけのスタックです。
# 書く値は 2 つだけで、秘密情報はありません。

# プロジェクト識別子。リソース名の接頭辞になります（英小文字・数字・ハイフン）。
# ecs/terraform.tfvars の project と同じ値にしてください。
project = "project-a"

# 用途を表す識別子。リソース名が project-a-git-... になります。
# 同じアカウントに別スタックを置くときに見分けが付きます（bootstrap と ecs で同じ値に）。
component = "git"

# リージョン。ecs 側と同じにしてください。
region = "ap-northeast-1"

# ★複数アカウントを扱うなら指定してください（ecs 側と同じ値）。
#   別アカウントの認証情報で実行するとエラーで止まります。
aws_profile         = "forge-project-a"   # プロファイル名。空なら環境変数 AWS_PROFILE を見ます
allowed_account_ids = ["111111111111"]
