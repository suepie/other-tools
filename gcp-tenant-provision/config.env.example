# provision.sh の共通設定。コピーして config.env にする（config.env はコミットしない）。
#
#   cp config.env.example config.env
#
# CSV には行ごとに変わる値だけを書き、環境で固定の値はここに置く。

# ---- 新規プロジェクトの置き場所（どちらか一方） ----
PARENT_FOLDER_ID="123456789012"
PARENT_ORG_ID=""

# ---- 課金アカウント ----
BILLING_ACCOUNT_ID="XXXXXX-XXXXXX-XXXXXX"

# 新規プロジェクトで有効化する API（カンマ区切り）
ENABLE_APIS="compute.googleapis.com,iam.googleapis.com"

# ---- FW ルールを作る先（Shared VPC ホストプロジェクト） ----
FW_PROJECT_ID="shared-vpc-host"
FW_NETWORK="shared-vpc"
# ルール名は "<FW_RULE_PREFIX>-<project_id>" になる
FW_RULE_PREFIX="egress"
FW_PRIORITY="1000"

# ---- SA を紐づける GCE がある先（Shared VPC サービスプロジェクト） ----
GCE_PROJECT_ID="service-project"
# set-service-account 時のスコープ
SA_SCOPES="cloud-platform"
# destroy 時に GCE へ戻す SA。空なら GCE プロジェクトの既定 Compute SA
GCE_RESTORE_SA=""

# ---- 動作 ----
# 作成直後のリソースが参照できるようになるまで待つ秒数
WAIT_SECONDS="60"
# 一時的なエラー時の再試行回数
RETRY_MAX="3"
